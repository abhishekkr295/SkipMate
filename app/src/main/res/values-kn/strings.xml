    <!-- About & Privacy -->
    <string name="about_title">ಕುರಿತು ಮತ್ತು ನೀತಿಗಳು</string>
    <string name="about_app_name">SkipMate v1.0.0</string>
    <string name="about_app_heading">ಅಪ್ಲಿಕೇಶನ್ ಬಗ್ಗೆ</string>
    <string name="about_app_body">ನಿಮ್ಮ YouTube ಅನುಭವವನ್ನು ಹೆಚ್ಚು ಅನುಕೂಲಕರವಾಗಿಸಲು ವಿನ್ಯಾಸಗೊಳಿಸಲಾದ ಈ ಅಪ್ಲಿಕೇಶನ್, ನೀವು ಕಾರ್ಯನಿರತರಾಗಿರುವಾಗ, ಊಟ ಮಾಡುವಾಗ ಅಥವಾ ನಿಮ್ಮ ಫೋನ್‌ನಿಂದ ದೂರದಲ್ಲಿರುವಾಗ ಜಾಹೀರಾತುಗಳನ್ನು ಹಸ್ತಚಾಲಿತವಾಗಿ ಬಿಟ್ಟುಬಿಡುವ ತೊಂದರೆಯನ್ನು ಕಡಿಮೆ ಮಾಡುವ ಗುರಿಯನ್ನು ಹೊಂದಿದೆ. ಕನಿಷ್ಠ ಬಳಕೆದಾರರ ಸಂವಹನದೊಂದಿಗೆ ಚುರುಕಾದ, ಹೆಚ್ಚು ಅನುಕೂಲಕರವಾದ ವೀಕ್ಷಣೆಯ ಅನುಭವವನ್ನು ರಚಿಸುವುದು ನಮ್ಮ ಗುರಿಯಾಗಿದೆ.</string>
    <string name="about_mission_heading">ನಮ್ಮ ಮಿಷನ್</string>
    <string name="about_mission_body">ಪ್ರಾಯೋಗಿಕ ತಂತ್ರಜ್ಞಾನ ಪರಿಹಾರಗಳ ಮೂಲಕ ಡಿಜಿಟಲ್ ವಿಷಯ ಬಳಕೆಯನ್ನು ಹೆಚ್ಚು ತಡೆರಹಿತ, ಅನುಕೂಲಕರ ಮತ್ತು ಬಳಕೆದಾರ ಸ್ನೇಹಿಯನ್ನಾಗಿ ಮಾಡಲು.</string>
    <string name="about_founder_heading">ಸ್ಥಾಪಕರು ಮತ್ತು ಡೆವಲಪರ್</string>
    <string name="about_founder_name">ಅಭಿಷೇಕ್ ಕೆ ಆರ್ (Abhishek K R)</string>
    <string name="about_founder_role">ಮುಖ್ಯ ಡೆವಲಪರ್ ಮತ್ತು ಸಾಫ್ಟ್‌ವೇರ್ ಆರ್ಕಿಟೆಕ್ಟ್\nಗೌಪ್ಯತೆ-ಗೌರವಿಸುವ, ಉನ್ನತ-ಉಪಯುಕ್ತತೆಯ ಸ್ಥಳೀಯ Android ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ನಿರ್ಮಿಸಲು ಸಮರ್ಪಿಸಲಾಗಿದೆ.</string>
    <string name="about_founder_contact">ಸಂಪರ್ಕ: support@skipmate.local • ಬೆಂಗಳೂರು, ಭಾರತ</string>
    <string name="about_accessibility_disclosure_title">Google Play ಪ್ರವೇಶಿಸುವಿಕೆ ನೀತಿ ಪ್ರಕಟಣೆ</string>
    <string name="about_accessibility_disclosure_body">ಪ್ರಮುಖ ಬಹಿರಂಗಪಡಿಸುವಿಕೆ ಮತ್ತು ಸ್ಪಷ್ಟ ಒಪ್ಪಿಗೆ:\n\nSkipMate ಅಧಿಕೃತ \'ಜಾಹೀರಾತುಗಳನ್ನು ಬಿಟ್ಟುಬಿಡಿ\' ಬಟನ್ ಯಾವಾಗ ಗೋಚರಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ಪತ್ತೆಹಚ್ಚಲು ಮತ್ತು ನಿಮ್ಮ ಪರವಾಗಿ ಕ್ಲಿಕ್ ಮಾಡಲು Android AccessibilityService API ಅನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಬಳಸುತ್ತದೆ.\n\n• ಶೂನ್ಯ ವೈಯಕ್ತಿಕ ಡೇಟಾ ಸಂಗ್ರಹಣೆ: ಯಾವುದೇ ಡೇಟಾ ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ.\n• 100% ಆಫ್‌ಲೈನ್ ಕಾರ್ಯಾಚರಣೆ: ಇಂಟರ್ನೆಟ್ ಅನುಮತಿ ಅಗತ್ಯವಿಲ್ಲ.</string>
    <string name="about_accessibility_footer">Google Play ನೀತಿಗಳೊಂದಿಗೆ ಹೊಂದಿಕೊಳ್ಳುತ್ತದೆ.</string>
    <string name="about_copyright_title">ಹಕ್ಕುಸ್ವಾಮ್ಯ ಮತ್ತು ಟ್ರೇಡ್‌ಮಾರ್ಕ್ ಮಾಹಿತಿ</string>
    <string name="about_copyright_body">© 2026 SkipMate ಅಭಿಷೇಕ್ ಕೆ ಆರ್ ಅವರಿಂದ. ಎಲ್ಲಾ ಹಕ್ಕುಗಳನ್ನು ಕಾಯ್ದಿರಿಸಲಾಗಿದೆ.\n\nYouTube Google LLC ನ ನೋಂದಾಯಿತ ಟ್ರೇಡ್‌ಮಾರ್ಕ್ ಆಗಿದೆ.</string>
    <string name="about_cookies_title">ಕುಕೀಸ್ ಮತ್ತು ಸ್ಥಳೀಯ ಸಂಗ್ರಹಣೆ ನೀತಿ</string>
    <string name="about_cookies_body">• ಶೂನ್ಯ ವೆಬ್ ಕುಕೀಗಳು: SkipMate ಸ್ಥಳೀಯ ಆಂಡ್ರಾಯ್ಡ್ ಅಪ್ಲಿಕೇಶನ್ ಆಗಿದೆ. ಇದು ಕುಕೀಗಳನ್ನು ಬಳಸುವುದಿಲ್ಲ.\n\n• ಸುರಕ್ಷಿತ ಸ್ಥಳೀಯ ಆದ್ಯತೆಗಳು: ಡೇಟಾವನ್ನು Jetpack DataStore ನಲ್ಲಿ ಸ್ಥಳೀಯವಾಗಿ ಉಳಿಸಲಾಗುತ್ತದೆ.</string>

